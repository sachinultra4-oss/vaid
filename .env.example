# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase Backend Configuration (see supabase/schema.sql)
# When configured in production, client/server sync with your Supabase project.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Owner Notification Webhook (e.g. email relay or WhatsApp alert service)
NOTIFICATION_WEBHOOK_URL=""

# Optional Session Secret for signed admin sessions (random key generated at runtime if omitted)
SESSION_SECRET=""
